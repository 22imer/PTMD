{"nodes": [{"id": "intent_research_pre_validate_neurosymbolic_guardrail", "label": "Neurosymbolic Defense-in-Depth Guardrail", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No static rule set can block 100% of adversarial prompts in an unbounded natural-language space (NIST/Vassilev incompleteness proof); deterministic filters must therefore be combined with semantic ML guardrails, prompt isolation and runtime execution rails."}, {"id": "intent_research_pre_validate_threat_model", "label": "Threat Model for Promptware Against Analysis Agent", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_static_indirect_prompt_injection", "label": "Static Indirect Prompt Injection", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_runtime_in_memory_promptware", "label": "Runtime / In-Memory Promptware", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_obfuscation_evasion", "label": "Obfuscation & Evasion Techniques", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_agent_hijacking", "label": "Agent Hijacking & Tool Misuse", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_false_positive_dilemma", "label": "False Positive Dilemma", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary malware always contains system-command strings (cmd.exe /c powershell -enc, bypass, admin, eval()); a guardrail must separate legitimate malware behaviour strings from Agent-manipulation commands without flagging the former."}, {"id": "intent_research_pre_validate_instruction_data_confusion", "label": "Instruction vs Data Confusion", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_excessive_agency_exploitation", "label": "Excessive Agency Exploitation", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_normalization_deobfuscation_engine", "label": "Normalization & De-obfuscation Engine", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Obfuscated payloads (Base64, Hex, Leetspeak, homoglyphs, zero-width characters) defeat plain keyword/regex filters, so decoding and Unicode normalization must run before YARA and the ML classifier."}, {"id": "intent_research_pre_validate_decision_policy_matrix", "label": "Decision Policy Matrix", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three graded responses are offered because reaction must stay proportional to investigation context: Tag-as-Evidence preserves analysis value, Sanitize/Drop removes the payload, Hard Block stops the pipeline for system-threatening injections."}, {"id": "intent_research_pre_validate_tag_as_evidence", "label": "Tag-as-Evidence Policy", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended default: do not destroy the malware analysis; neutralize the injected command by turning it into passive data and tagging it as Anti-Agent / Evasion behaviour (T1497 / AML.T0051) in the final report."}, {"id": "intent_research_pre_validate_sanitize_drop_policy", "label": "Sanitize / Drop Policy", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a payload cannot be safely retained as evidence it is replaced with a safe placeholder such as [REDACTED_PROMPT_INJECTION] before reaching the Agent."}, {"id": "intent_research_pre_validate_hard_block_policy", "label": "Hard Block Policy", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved for injections that threaten the analysis system itself, where continuing the pipeline is unacceptable."}, {"id": "intent_research_pre_validate_semantic_ml_guardrail", "label": "Semantic ML Guardrail Layer", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_execution_rails", "label": "Runtime Execution Rails & Output Governance", "file_type": "rationale", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even if the Agent's reasoning is hijacked, least-privilege execution rails must deny shell, file-write and network-egress tools so no harmful action is reachable."}, {"id": "intent_research_pre_validate_prompt_isolation", "label": "Prompt Isolation / Spotlighting", "file_type": "concept", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_standard_mapping_table", "label": "Security Standards Mapping Table", "file_type": "document", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "intent_research_pre_validate_research_acceptance_criteria", "label": "Research Phase Acceptance Criteria", "file_type": "document", "source_file": "intent/research_pre_validate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "intent_research_pre_validate_threat_model", "target": "intent_research_pre_validate_static_indirect_prompt_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "intent/research_pre_validate.md", "source_location": null, "weight": 1.0}, {"source": "intent_research_pre_validate_threat_model", "target": "intent_research_pre_validate_runtime_in_memory_promptware", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "intent/research_pre_validate.md", "source_location": null, "weight": 1.0}, {"source": "intent_research_pre_validate_threat_model", "target": "intent_research_pre_validate_instruction_data_confusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "intent/research_pre_validate.md", "source_location": nul