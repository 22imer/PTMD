{"nodes": [{"id": "specs_guardrail_malware_agent_spec_neurosymbolic_defense_pipeline", "label": "Neurosymbolic Defense-in-Depth Pipeline", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_layer0_normalization", "label": "Layer 0 - Normalization & De-obfuscation Engine", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded recursive decoding (max depth 2, 64 KB block, ASCII printable ratio >= 80%) is limited on purpose to avoid mis-decoding shellcode binaries while still peeling common encoding layers."}, {"id": "specs_guardrail_malware_agent_spec_layer1a_static_scanner", "label": "Layer 1A - Static Scanner", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_layer1b_sandbox_dynamic_extraction", "label": "Layer 1B - Sandbox & Dynamic Artifact Extraction", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_layer2a_capa_abstraction", "label": "Layer 2A - CAPA Data Abstraction", "file_type": "rationale", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Agent is most exposed when reading free-text raw strings and disassembly; CAPA converts them into structured ATT&CK capability JSON, eliminating ~95% of the promptware attack surface while retaining 100% of behavioural value."}, {"id": "specs_guardrail_malware_agent_spec_layer2b_yara_cuckoo_ram_scan", "label": "Layer 2B - YARA Cuckoo & RAM Scan", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_layer3_semantic_ml_guardrail", "label": "Layer 3 - Semantic ML Guardrail", "file_type": "concept", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_layer4_decision_policy_gate", "label": "Layer 4 - Decision Policy Gate & Prompt Isolation", "file_type": "rationale", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tag-as-Evidence is chosen over dropping the sample so adversarial instructions become passive evidence rather than lost intelligence; strict XML delimiters keep the instruction channel separate from the untrusted malware data channel."}, {"id": "specs_guardrail_malware_agent_spec_layer5_execution_rails", "label": "Layer 5 - Runtime Execution Rails & Output Governance", "file_type": "rationale", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Least privilege is enforced by never registering shell, file-write or network tools, so a manipulated Agent has no capability to cause harm, and JSON-Schema validation constrains its output."}, {"id": "specs_guardrail_malware_agent_spec_read_only_dispatcher", "label": "Hardcoded Read-Only Dispatcher", "file_type": "rationale", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only three query functions (get_pe_header_details, get_mitre_capabilities, get_quarantined_evidence) are exposed; capability removal, not prompt wording, is the last line of defence."}, {"id": "specs_guardrail_malware_agent_spec_spotlighting_xml_delimiters", "label": "Spotlighting XML Delimiters", "file_type": "rationale", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Untrusted telemetry is wrapped in system_policy, untrusted_malware_telemetry and quarantined_adversarial_evidence tags so the model can tell data from instructions, and any command inside them is defined to be an evasion attempt."}, {"id": "specs_guardrail_malware_agent_spec_quarantined_evidence_schema", "label": "QuarantinedAdversarialEvidence Schema", "file_type": "document", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_final_report_schema", "label": "MalwareAgentFinalReport Schema", "file_type": "document", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_security_standards_mapping_matrix", "label": "Security Standards Mapping Matrix", "file_type": "document", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_agent_spec_synthetic_pe_dataset", "label": "Synthetic PE Evaluation Dataset (300 samples)", "file_type": "document", "source_file": "specs/guardrail_malware_agent_spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_guardrail_malware_ag